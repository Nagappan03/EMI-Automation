generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobRun {
  id           String   @id @default(cuid())
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  status       String
  triggeredBy  String   @default("CRON")
  axisStatus   String?
  kotakStatus  String?
  errorMessage String?
}

model ProcessedStatement {
  id           String   @id @default(cuid())
  bank         String
  statementKey String   @unique
  processedAt  DateTime @default(now())
}

model MonthlyNotification {
  id        String   @id @default(cuid())
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  month     Int
  year      Int
  status    String   @default("PENDING") // SUCCESS | FAILED | RUNNING
  triggeredBy  String   @default("CRON")
  type      String   // EMAIL or WHATSAPP
  sentAt    DateTime @default(now())
  errorMessage String?
}